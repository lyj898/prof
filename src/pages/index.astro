---
import '../styles/global.css';
import '../styles/dashboard.css';
import Dashboard from '../components/Dashboard.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Faculty Directory — YOUR Venture</title>

    <!-- Fonts: Fraunces (display), IBM Plex Sans (UI), IBM Plex Mono (numbers) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Whole dashboard is one client:only React island: login gate + live CRUD. -->
    <Dashboard client:only="react" />
  </body>
</html>
