# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).
#
# These are PUBLIC_-prefixed because the dashboard is a client-only React island
# that talks to Supabase directly from the browser. The anon key is designed to be
# public — row access is still gated by RLS (authenticated users only).
#
# .env.local is gitignored. Never commit real values.

PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# Service role (secret) key — used ONLY by the seed script (`npm run seed`) to bulk-import
# data through the Supabase API. It bypasses RLS, so treat it like a password:
# no PUBLIC_ prefix (never shipped to the browser), and .env.local is gitignored.
# Get it from: Supabase dashboard → Settings → API Keys → secret key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-SECRET-KEY"
